# ── Base de datos PostgreSQL ─────────────────────────────────────────────
# DATABASE_URL: la usa la app. DIRECT_URL: la usa Prisma para las migraciones.
#
# PORTÁTIL DEL EVENTO (sin internet): PostgreSQL instalado en el mismo computador.
#   Usa la misma URL en las dos y cambia "postgres:postgres" por tu usuario:contraseña de PostgreSQL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/desafio_tolota"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/desafio_tolota"

# NUBE (histórico): base en Supabase a la que se copian los datos con "Respaldo → Sincronizar ahora".
#   Solo en el portátil del evento. Usa el *Session pooler* (puerto 5432) de Supabase.
#   Déjala vacía si este servidor no debe sincronizar.
NUBE_DATABASE_URL=""
# NUBE_DATABASE_URL="postgresql://postgres.TU_REF:TU_CLAVE@aws-0-TU_REGION.pooler.supabase.com:5432/postgres"

# SITIO EN LA NUBE (Vercel): ahí DATABASE_URL y DIRECT_URL son las de Supabase:
#  DATABASE_URL = Transaction pooler, puerto 6543, con ?pgbouncer=true&connection_limit=1
#  DIRECT_URL   = Session pooler, puerto 5432
#  (y NUBE_DATABASE_URL no se define)

# ── Inicio de sesión (Administrador / Cronometrador) ─────────────────────
# Las contraseñas se crean en la terminal del servidor: "Iniciar evento.bat" las pide la primera vez,
# o en cualquier momento con: npm run claves. Luego se cambian en Respaldo → Contraseñas.
# Opcional: contraseñas iniciales desde aquí (útil en el sitio en la nube, donde no hay terminal).
ADMIN_PASSWORD=""
CRONO_PASSWORD=""
# Secreto para firmar las sesiones (obligatorio en producción). "Iniciar evento.bat" lo genera solo en el portátil.
# En Vercel: genera uno con  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
