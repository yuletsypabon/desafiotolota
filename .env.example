# Cadena de conexión PostgreSQL
#  - Local:   postgresql://postgres:postgres@localhost:5432/desafio_tolota
#  - Vercel:  usa la URL de Neon / Vercel Postgres (con ?sslmode=require)
#  - Azure:   postgresql://USUARIO:CLAVE@SERVIDOR.postgres.database.azure.com:5432/desafio_tolota?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/desafio_tolota"

# Opcional: si se define, todo el sitio pide usuario/contraseña (HTTP Basic).
# Usuario: ADMIN_USER (por defecto "admin").
ADMIN_USER="admin"
ADMIN_PASSWORD=""

