// DESAFÍO Tolotá — modelo de datos (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexión con pooler (app)
  directUrl = env("DIRECT_URL") // conexión directa/sesión (migraciones)
}

enum EstadoPrueba {
  PENDIENTE
  EN_CURSO
  FINALIZADA
}

enum Rol {
  ADMIN
  CRONO
}

enum TipoPunto {
  LEVE
  MEDIA
  GRAVE
  POSITIVO
}

/// Un evento (edición) del desafío. Puede haber varios por año.
model Evento {
  id            String   @id @default(cuid())
  anio          Int
  nombre        String
  logo          String? /// data URL (imagen redimensionada en el navegador)
  numPistas     Int      @default(3)
  pulsadorKey   String   @default("A")
  /// Penalizaciones / bonificaciones de disciplina en milisegundos (siempre positivos)
  penLeveMs     Int      @default(300)
  penMediaMs    Int      @default(500)
  penGraveMs    Int      @default(1000)
  bonPositivoMs Int      @default(100)
  descuentoEspiritualPorPuntoMs Float @default(0.02)
  /// Nombre del reto por categoría de equipo (2 o 4 integrantes); se muestra en la portada: "Desafío X2: (nombre)"
  nombreX2      String?
  nombreX4      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  pruebas Prueba[]
  equipos Equipo[]

  @@index([anio])
}

model Prueba {
  id              String       @id @default(cuid())
  eventoId        String
  nombre          String
  posicion        Int          @default(0)
  estado          EstadoPrueba @default(PENDIENTE)
  /// IDs de equipo en el orden de salida. Equipos que no estén aquí salen al final por número.
  ordenSalida     String[]     @default([])
  /// Desde cuándo el cronometrador puede usar la prueba (null = no habilitada)
  habilitadaDesde DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  evento     Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  resultados Resultado[]
  puntos     PuntoDisciplina[]
  actividadesEspirituales ActividadEspiritual[]
  reservas   Reserva[]

  @@index([eventoId])
}

model Equipo {
  id        String   @id @default(cuid())
  eventoId  String
  numero    Int
  nombre    String
  capitan   String?
  logo      String?
  /// Color del equipo (#rrggbb) para la carta del capitán; null = se toma del logo
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evento        Evento            @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  participantes Participante[]
  resultados    Resultado[]
  puntos        PuntoDisciplina[]
  puntajesEspirituales PuntajeEspiritual[]
  reservas             Reserva[]

  @@unique([eventoId, nombre])
  @@index([eventoId])
}

/// Ficha del participante (datos personales, contacto de emergencia y ficha médica)
model Participante {
  id                 String   @id @default(cuid())
  equipoId           String
  nombre             String
  fechaNacimiento    String? /// YYYY-MM-DD
  telefono           String?
  email              String?
  residencia         String?
  profesion          String?
  contactoNombre     String?
  contactoParentesco String?
  contactoTelefono   String?
  tipoSangre         String?
  alergias           String?
  enfermedades       String?
  medicamentos       String?
  limitaciones       String?
  observaciones      String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  equipo Equipo            @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  puntos PuntoDisciplina[]

  @@index([equipoId])
}

/// Tiempo de un equipo en una prueba. El tiempo final se calcula (bruto − detenciones ± disciplina)
model Resultado {
  id            String   @id @default(cuid())
  pruebaId      String
  equipoId      String
  pista         Int?
  salidaAt      DateTime
  llegadaAt     DateTime
  brutoMs       Int
  detencionesMs Int      @default(0)
  /// [{ "num": 1, "dur": 1234 }, ...]
  detenciones   Json     @default("[]")
  observacion   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  prueba Prueba @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([pruebaId, equipoId])
}

model PuntoDisciplina {
  id             String    @id @default(cuid())
  pruebaId       String
  equipoId       String
  participanteId String?
  tipo           TipoPunto
  descripcion    String?
  hora           String? /// HH:MM
  createdAt      DateTime  @default(now())

  prueba       Prueba        @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  equipo       Equipo        @relation(fields: [equipoId], references: [id], onDelete: Cascade)
  participante Participante? @relation(fields: [participanteId], references: [id], onDelete: SetNull)

  @@index([pruebaId])
  @@index([equipoId])
}

model ActividadEspiritual {
  id        String   @id @default(cuid())
  pruebaId  String
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prueba   Prueba             @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  puntajes PuntajeEspiritual[]

  @@index([pruebaId])
}

model PuntajeEspiritual {
  id          String   @id @default(cuid())
  actividadId String
  equipoId    String
  puntos      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  actividad ActividadEspiritual @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  equipo    Equipo              @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([actividadId, equipoId])
  @@index([equipoId])
}

/// Contraseña de cada rol (hash scrypt). Solo en la base local: no se sincroniza a la nube.
model Credencial {
  rol       Rol      @id
  hash      String
  updatedAt DateTime @updatedAt
}

/// Clave adicional para habilitar el histórico a la sesión del cronometrador.
model ClaveHistorico {
  id        String   @id @default("historico")
  hash      String
  updatedAt DateTime @updatedAt
}

/// Equipo cargado en una pista de algún dispositivo: mientras exista, los demás dispositivos no lo cargan.
/// Cada dispositivo la renueva cada pocos segundos; si deja de hacerlo (se cerró), vence sola.
model Reserva {
  id          String   @id @default(cuid())
  pruebaId    String
  equipoId    String
  dispositivo String
  pista       Int
  updatedAt   DateTime @updatedAt

  prueba Prueba @relation(fields: [pruebaId], references: [id], onDelete: Cascade)
  equipo Equipo @relation(fields: [equipoId], references: [id], onDelete: Cascade)

  @@unique([pruebaId, equipoId])
}
